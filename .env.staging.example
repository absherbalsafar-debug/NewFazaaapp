# Staging only. Store actual values in the deployment secret manager, not Git.
NODE_ENV=staging
DATABASE_URL=postgresql://fazaa_staging:change-me@staging-db.internal:5432/fazaa_staging
SESSION_SECRET=replace-with-a-different-32-plus-character-secret
CORS_ORIGINS=https://staging-app.fazaa.com,https://staging-admin.fazaa.com
TRUST_PROXY=true
PRIVATE_OBJECT_DIR=/fazaa-staging-private
